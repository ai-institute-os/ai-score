# Database
DATABASE_URL=postgresql+asyncpg://aiscore:aiscore_dev@localhost:5432/aiscore
POSTGRES_USER=aiscore
POSTGRES_PASSWORD=aiscore_dev
POSTGRES_DB=aiscore

# Redis (prompt caching)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=info

# --- LLM Provider API Keys (set per-tenant in DB; these are fallback defaults) ---

# OpenAI
OPENAI_API_KEY=sk-...

# Google Gemini
GOOGLE_API_KEY=AIza...

# Perplexity
PERPLEXITY_API_KEY=pplx-...

# Azure OpenAI (Copilot proxy)
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-05-01-preview
BING_SEARCH_API_KEY=...

# Rate limits (requests per minute, per provider)
RATE_LIMIT_OPENAI=60
RATE_LIMIT_GEMINI=60
RATE_LIMIT_PERPLEXITY=20
RATE_LIMIT_COPILOT=30

# Prompt cache TTL in seconds
CACHE_TTL_SECONDS=300
