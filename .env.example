# Database
DATABASE_URL=postgresql+asyncpg://[USER]:[PASSWORD]@[HOST]:5432/[DB]
POSTGRES_USER=[DB_USER]
POSTGRES_PASSWORD=[SECURE_PASSWORD]
POSTGRES_DB=[DB_NAME]

# Redis (prompt caching)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=info

# Fernet key for encrypting LLM provider API keys at rest in the database.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MUST be set in production. If absent, keys are stored in plaintext.
LLM_ENCRYPTION_KEY=

# --- LLM Provider API Keys (set per-tenant in DB; these are fallback defaults) ---

# OpenAI
OPENAI_API_KEY=sk-...

# Google Gemini
GOOGLE_API_KEY=AIza...

# Perplexity
PERPLEXITY_API_KEY=pplx-...

# Azure OpenAI (Copilot proxy)
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-05-01-preview
BING_SEARCH_API_KEY=...

# Rate limits (requests per minute, per provider)
RATE_LIMIT_OPENAI=60
RATE_LIMIT_GEMINI=60
RATE_LIMIT_PERPLEXITY=20
RATE_LIMIT_COPILOT=30

# Prompt cache TTL in seconds
CACHE_TTL_SECONDS=300
